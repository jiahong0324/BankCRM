Do not modify this file. It is generated by NetBeans and will be overwritten.
-->
<project name="BankCRM-impl" basedir="..">
    <fail message="Please build using Ant 1.8.0 or higher." unless="ant.version"/>
    <property file="nbproject/private/private.properties"/>
    <property file="nbproject/project.properties"/>

    <condition property="no.deps">
        <and>
            <istrue value="${no.dependencies}"/>
        </and>
    </condition>

    <target name="-pre-init"><!-- empty placeholder --></target>
    <target name="-post-init"><!-- empty placeholder --></target>

    <target name="-init-private">
        <property file="nbproject/private/private.properties"/>
    </target>

    <target name="-init-user">
        <property file="${user.home}/.netbeans/system/build.properties"/>
    </target>

    <target name="-init-project">
        <property file="nbproject/project.properties"/>
    </target>

    <target name="-init-macrodefs-property">
        <macrodef name="property" uri="http://www.netbeans.org/ns/j2se-project/1">
            <attribute name="name"/>
            <attribute name="value"/>
            <sequential>
                <property name="@{name}" value="@{value}"/>
            </sequential>
        </macrodef>
    </target>

    <target name="-init-macrodefs-javac">
        <macrodef name="javac" uri="http://www.netbeans.org/ns/j2se-project/3">
            <attribute name="srcdir" default="${src.dir}"/>
            <attribute name="destdir" default="${build.classes.dir}"/>
            <attribute name="classpath" default="${javac.classpath}"/>
            <attribute name="processorpath" default="${javac.processorpath}"/>
            <attribute name="apgeneratedsrcdir" default="${build.generated.sources.dir}/ap-source-output"/>
            <attribute name="includes" default="${includes}"/>
            <attribute name="excludes" default="${excludes}"/>
            <attribute name="debug" default="true"/>
            <attribute name="sourcepath" default=""/>
            <attribute name="gensrcdir" default="${build.generated.sources.dir}"/>
            <element name="customize" optional="true"/>
            <sequential>
                <javac
                    srcdir="@{srcdir}"
                    destdir="@{destdir}"
                    includes="@{includes}"
                    excludes="@{excludes}"
                    classpath="@{classpath}"
                    debug="@{debug}"
                    source="${javac.source}"
                    target="${javac.target}"
                    encoding="${source.encoding}"
                    includeantruntime="false">
                    <customize/>
                </javac>
            </sequential>
        </macrodef>
    </target>

    <target name="-init-macrodefs-junit"><!-- empty placeholder --></target>

    <target name="init" depends="-pre-init,-init-private,-init-user,-init-project,-init-macrodefs-property,-init-macrodefs-javac,-init-macrodefs-junit,-post-init"/>

    <!-- ==================== Clean ==================== -->
    <target name="-pre-clean"><!-- empty --></target>
    <target name="-post-clean"><!-- empty --></target>
    <target name="clean" depends="init,-pre-clean,-post-clean" description="Clean build products.">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <!-- ==================== Compile ==================== -->
    <target name="-pre-compile"><!-- empty --></target>
    <target name="-post-compile"><!-- empty --></target>
    <target name="-init-source-paths">
        <mkdir dir="${src.dir}"/>
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${build.generated.sources.dir}/ap-source-output"/>
    </target>

    <target name="compile" depends="init,-init-source-paths,-pre-compile" description="Compile project sources.">
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               classpath="${javac.classpath}"
               source="${javac.source}"
               target="${javac.target}"
               debug="true"
               encoding="${source.encoding}"
               includeantruntime="false">
            <compilerarg value="-Xlint:none"/>
        </javac>
        <antcall target="-post-compile"/>
    </target>

    <!-- ==================== JAR ==================== -->
    <target name="-pre-jar"><!-- empty --></target>
    <target name="-post-jar"><!-- empty --></target>
    <target name="-do-jar-create-manifest">
        <mkdir dir="${build.dir}"/>
        <manifest file="${build.dir}/MANIFEST.MF" mode="replace">
            <attribute name="Main-Class" value="${main.class}"/>
        </manifest>
    </target>

    <target name="-do-jar-compress-false" unless="jar.compress">
        <jar jarfile="${dist.jar}" manifest="${build.dir}/MANIFEST.MF" compress="false" index="false" filesetmanifest="skip">
            <fileset dir="${build.classes.dir}"/>
        </jar>
    </target>

    <target name="jar" depends="compile,-pre-jar,-do-jar-create-manifest,-do-jar-compress-false,-post-jar" description="Build JAR.">
        <echo message="To run this application from the command line without Ant, try: "/>
        <echo message="java -jar &quot;${dist.jar}&quot;"/>
    </target>

    <!-- ==================== Run ==================== -->
    <target name="-pre-run-main"><!-- empty --></target>
    <target name="-post-run-main"><!-- empty --></target>

    <target name="run" depends="compile,-pre-run-main" description="Run project.">
        <java fork="true" classname="${main.class}" classpath="${build.classes.dir}">
            <jvmarg value="-Dawt.useSystemAAFontSettings=on"/>
            <jvmarg value="-Dswing.aatext=true"/>
        </java>
        <antcall target="-post-run-main"/>
    </target>

    <!-- ==================== Debug ==================== -->
    <target name="-debug-start-debuggee" depends="compile">
        <java fork="true" classname="${main.class}" classpath="${build.classes.dir}">
            <jvmarg value="-Xdebug"/>
            <jvmarg value="-Xrunjdwp:transport=dt_socket,address=${jpda.address}"/>
            <jvmarg value="-Dawt.useSystemAAFontSettings=on"/>
            <jvmarg value="-Dswing.aatext=true"/>
        </java>
    </target>
    <target name="debug" depends="init,compile,-debug-start-debuggee" description="Debug project."/>

    <!-- ==================== Javadoc ==================== -->
    <target name="javadoc" depends="init" description="Build Javadoc.">
        <mkdir dir="${dist.javadoc.dir}"/>
        <javadoc destdir="${dist.javadoc.dir}" source="${javac.source}" encoding="${source.encoding}" windowtitle="${application.title}">
            <fileset dir="${src.dir}" includes="**/*.java"/>
        </javadoc>
    </target>

    <!-- ==================== Test (stub) ==================== -->
    <target name="test" depends="compile" description="Run tests (none defined).">
        <echo message="No tests defined."/>
    </target>

    <!-- ==================== Profile (stub) ==================== -->
    <target name="profile" depends="compile" description="Profile project.">
        <fail message="This target only works when invoked from inside the NetBeans IDE."/>
    </target>

</project>
